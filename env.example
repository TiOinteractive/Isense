#--------------------------------------------------------------------
# Przykladowa konfiguracja srodowiska
#
# Skopiuj ten plik jako .env i uzupelnij wartosciami swojego srodowiska:
#     cp env.example .env
#
# .env jest w .gitignore i NIGDY nie trafia do repozytorium - trzymaj
# w nim prawdziwe hasla, tokeny i klucze. Tutaj wylacznie placeholdery.
#
# Dodajesz nowy klucz w .env? Dopisz go tez tutaj (z placeholderem),
# zeby kolejna osoba wiedziala, ze go potrzebuje.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production
 CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# CONSTANTS
#--------------------------------------------------------------------

# Segment URL, pod ktorym siedzi caly panel administracyjny.
 ADMIN_PANEL_SLUG = tiocms

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

 app.baseURL = 'http://resinet.local'
# app.forceGlobalSecureRequests = false

# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Grupa 'default' jest wymagana. Pozostale grupy sa uzywane przez
# konkretne moduly (Newsletter, Shopping, ...) - jesli nie korzystasz
# z modulu, mozesz zostawic jego grupe niewypelniona.

 database.default.hostname = 127.0.0.1
 database.default.database = nazwa_bazy
 database.default.username = uzytkownik
 database.default.password = haslo
 database.default.DBDriver = MySQLi
 database.default.DBPrefix = tio_
 database.default.port = 3306

# database.tests.hostname = localhost
# database.tests.database = ci4
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =

