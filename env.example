#--------------------------------------------------------------------
# Images
#--------------------------------------------------------------------
# Limity i dozwolone typy MIME dla uploadu / menedzera plikow.

# images.libraryPath = '/usr/local/apache/modules/imagick-3.7.0.so'
 images.maxImageDims = '3000,3000'
 images.maxFileSize = '5120'
 images.imageMimeIn = 'image/jpg,image/jpeg,image/gif,image/png,image/webp'
 images.audioMimeIn = 'audio/mpeg'
 images.videoMimeIn = 'video/mp4'
 images.importMimeIn = 'text/csv,text/xml,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/msword'
 images.otherMimeIn = 'application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.oasis.opendocument.text,application/pdf,application/vnd.oasis.opendocument.presentation,application/vnd.oasis.opendocument.spreadsheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/octet-stream'
 images.mimeIn = 'image/jpg,image/jpeg,image/gif,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,audio/mpeg,video/mp4,application/vnd.oasis.opendocument.text,application/pdf,application/vnd.oasis.opendocument.presentation,application/vnd.oasis.opendocument.spreadsheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/octet-stream'
 images.extIn = 'jpg,jpeg,gif,png,webp,doc,docx,mp3,mp4,odt,pdf,odp,ods,ppt,pptx,xls,xlsx'

#--------------------------------------------------------------------
# Event - import kupbilecik
#--------------------------------------------------------------------
# Klucz = id_page_cont bloku docelowego (lista wydarzen), wartosc = adres feedu.
# Pusty lub zakomentowany adres = feed pomijany przez CronJob::import().
# Nowy blok wymaga tez zadeklarowania klucza w app/Config/Event.php.
#
# Bez tego klucza na produkcji import po cichu przestanie dzialac -
# petla pominie feed, bez bledu i bez maila z podsumowaniem.

 event.importUrls.36 = 'https://www.kupbilecik.pl/api/?m=816,14&ap=resinet&t=json&v=1.0&p=499&token=TOKEN'
# event.importUrls.125 = ''

# Odbiorcy maila z podsumowaniem importu, po przecinku. Bez tego klucza obowiazuje
# domyslna lista z app/Config/Event.php - przydatne na dev, zeby przekierowac maile
# na skrzynke testowa zamiast do redakcji.
 event.importMailTo = 'ktos@example.com,ktos.inny@example.com'

#--------------------------------------------------------------------
# Email
#--------------------------------------------------------------------

 email.fromEmail = 'powiadomienia@example.com'
 email.fromName = 'TiO CMS'
 email.userAgent = 'CodeIgniter'
 email.protocol = 'smtp'
 email.protocolNewsletter = 'mail'
 email.mailPath = '/usr/sbin/sendmail'
 email.SMTPHost = 'poczta.example.com'
 email.SMTPUser = 'powiadomienia@example.com'
 email.SMTPPass = 'haslo_smtp'
 email.SMTPPort = '587'
 email.SMTPCrypto = 'tls'
 email.charset = 'UTF-8'

#--------------------------------------------------------------------
# Social - logowanie zewnetrzne
#--------------------------------------------------------------------

 social.facebookAppId = 'facebook_app_id'
 social.facebookAppSecret = 'facebook_app_secret'
 social.googleClientId = 'google_client_id.apps.googleusercontent.com'
 social.googleClientSecret = 'google_client_secret'

#--------------------------------------------------------------------
# Instagram - import postow przez cron (moduly News, Flavors)
#--------------------------------------------------------------------

 instagram.appId = 'instagram_app_id'
 instagram.appSecret = 'instagram_app_secret'

#--------------------------------------------------------------------
# Mapbox - kafelki dla map OpenStreetMap (modul Maps)
#--------------------------------------------------------------------
# Nadpisywalne per mapa w ustawieniach modulu (settings.mapbox_token).

 mapbox.accessToken = 'pk.mapbox_access_token'

#--------------------------------------------------------------------
# Google Maps - klucz API (moduly Event, Maps, News)
#--------------------------------------------------------------------
# Nadpisywalny per modul w ustawieniach (settings.google_map_key).

 google.mapsApiKey = 'google_maps_api_key'
